# Apollo.io
APOLLO_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gmail OAuth
GMAIL_CLIENT_SECRET_PATH=client_secret.json
GMAIL_TOKEN_PATH=data/token.json

# Storage
DATABASE_PATH=data/app.db
RESUME_DIR=resumes
# Your name with no spaces -- the app looks for resumes/<CANDIDATE_NAME>Resume.pdf
CANDIDATE_NAME=YourName

# Safety guardrails
MAX_EMAILS_PER_RUN=10
TEST_SEND_MODE=true
TEST_SEND_EMAIL=example@gmail.com
SEND_DELAY_MIN_SECONDS=60
SEND_DELAY_MAX_SECONDS=120
